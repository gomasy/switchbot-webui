{
  "name": "switchbot-webui",
  "version": "1.3.1",
  "private": true,
  "type": "module",
  "source": "src/index.html",
  "scripts": {
    "dev": "npm run clean && node scripts/gen-version.mjs && concurrently -k \"parcel watch\" \"cargo run\"",
    "build": "npm run clean && node scripts/gen-version.mjs && parcel build",
    "start": "cargo run --release",
    "clean": "rm -rf dist .parcel-cache"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "parcel": "^2.16.4",
    "process": "^0.11.10",
    "typescript": "^7.0.0"
  },
  "browserslist": "> 0.5%, last 2 versions, not dead"
}
