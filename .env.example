SWITCHBOT_TOKEN=your_token_here
SWITCHBOT_SECRET=your_secret_here
# Optional: server port (default: 3000)
#PORT=3000
# Optional: require this token to access the UI (recommended when exposed beyond localhost)
#AUTH_TOKEN=choose_a_long_random_string
# Optional: seconds to cache device status responses to stay under the API rate limit (default: 5, 0 disables)
#STATUS_CACHE_TTL=5
# Optional: public URL SwitchBot should POST webhook events to. When set, the server
# registers the webhook and pushes realtime updates to the UI over WebSocket.
# Must be reachable from the internet (e.g. https://home.example.com/webhook).
#WEBHOOK_URL=https://your-host/webhook
